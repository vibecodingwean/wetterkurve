<Window x:Class="Wetterkurve.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wetterkurve"
        Width="720" Height="560"
        MinWidth="600" MinHeight="480"
        Background="#202A3A"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <DockPanel Margin="14,10,14,8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="RemoveLocationButton"
                    DockPanel.Dock="Right"
                    Content="−"
                    FontSize="18"
                    FontWeight="Bold"
                    MinWidth="32"
                    Padding="7,1,7,4"
                    Click="RemoveLocation_Click"
                    ToolTip="Ort entfernen"/>
            <WrapPanel x:Name="LocationTabs" VerticalAlignment="Center"/>
        </DockPanel>

        <Border x:Name="SearchBox"
                DockPanel.Dock="Top"
                Background="#47080C16"
                BorderBrush="#21FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBox x:Name="SearchEntry"
                         FontSize="14"
                         Padding="8,6"
                         Background="#33000000"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#4499CCFF"
                         TextChanged="SearchEntry_TextChanged"
                         KeyDown="SearchEntry_KeyDown"/>
                <TextBlock x:Name="SearchHint"
                           Margin="2,6,0,4"
                           FontSize="11"
                           Foreground="#B8EBF5FF"/>
                <StackPanel x:Name="SearchResults"/>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    Content="↻"
                    FontSize="20"
                    Width="36" Height="36"
                    VerticalAlignment="Center"
                    Click="Refresh_Click"/>
            <TextBlock x:Name="TemperatureLabel"
                       DockPanel.Dock="Right"
                       Text="–°"
                       FontSize="34"
                       FontWeight="Light"
                       MinWidth="84"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="8,0"/>
            <Image x:Name="ConditionIcon"
                   DockPanel.Dock="Right"
                   Width="52" Height="52"
                   Margin="6,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleLabel" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="ConditionLabel" FontSize="13" Opacity="0.92"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock x:Name="FeelsValue" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="FeelsName" Style="{StaticResource StatName}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="3,0">
                <StackPanel>
                    <TextBlock x:Name="RainValue" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="RainName" Style="{StaticResource StatName}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="3,0">
                <StackPanel>
                    <TextBlock x:Name="WindValue" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="WindName" Style="{StaticResource StatName}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="HumidityValue" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="HumidityName" Style="{StaticResource StatName}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="LegendLabel"
                       DockPanel.Dock="Right"
                       FontSize="11"
                       Opacity="0.9"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SectionTitle" FontSize="14" FontWeight="Bold"/>
        </DockPanel>

        <TextBlock x:Name="StatusLabel"
                   DockPanel.Dock="Bottom"
                   FontSize="10"
                   Opacity="0.85"
                   HorizontalAlignment="Right"
                   Margin="0,6,0,0"/>

        <Border x:Name="ChartHost"
                Background="#4C080C16"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                MinHeight="220">
            <Image x:Name="ChartImage"
                   Stretch="Fill"
                   MinHeight="220"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
    </DockPanel>
</Window>
