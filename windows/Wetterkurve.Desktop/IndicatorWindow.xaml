<Window x:Class="Wetterkurve.Desktop.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wetterkurve"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border Background="#F2202A3A"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8,5,10,5"
            Cursor="Hand">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="ConditionIcon"
                   Width="22" Height="22"
                   Margin="0,0,7,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="TemperatureLabel"
                       Text="–°"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="CityLabel"
                       Text="Wetterkurve"
                       FontSize="15"
                       Opacity="0.92"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
