<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.wetterkurve" path="/org/gnome/shell/extensions/wetterkurve/">
    <key name="language" type="s">
      <default>'en'</default>
      <choices><choice value="en"/><choice value="de"/></choices>
      <summary>Interface language</summary>
    </key>
    <key name="locations" type="s">
      <default>'[{"id":"52.5200,13.4050","name":"Berlin","label":"Berlin, Germany","latitude":52.520,"longitude":13.405,"timezone":"Europe/Berlin"}]'</default>
      <summary>Saved weather locations</summary>
    </key>
    <key name="active-location" type="i">
      <default>0</default>
      <range min="0" max="2"/>
      <summary>Index of the selected weather location</summary>
    </key>
    <key name="show-clouds" type="b">
      <default>true</default>
      <summary>Show the cloud-cover band on the forecast chart</summary>
    </key>
    <key name="show-wind" type="b">
      <default>false</default>
      <summary>Show the wind curve on the forecast chart</summary>
    </key>
    <key name="show-feels-like" type="b">
      <default>false</default>
      <summary>Show the feels-like curve on the forecast chart</summary>
    </key>
  </schema>
</schemalist>
